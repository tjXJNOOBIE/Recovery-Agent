{
  "name": "@tjxjnoobie/recovery-agent",
  "version": "0.2.0",
  "description": "Java-owned control-host Recovery Agent with an npm installation and launcher layer.",
  "type": "module",
  "bin": {
    "recovery-agent": "./bin/recovery-agent.mjs"
  },
  "files": [
    "bin",
    "runtime",
    "runtime-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:legacy": "tsc -p tsconfig.build.json",
    "typecheck:legacy": "tsc -p tsconfig.json --noEmit",
    "test:legacy": "tsc -p tsconfig.test.json && node --test \".test-dist/test/**/*.test.js\"",
    "check:legacy": "npm run typecheck:legacy && npm run test:legacy && npm run build:legacy",
    "package:runtime": "node scripts/package-runtime.mjs",
    "check:package": "npm run package:runtime && node bin/recovery-agent.mjs doctor",
    "check": "npm run check:legacy && npm run check:package",
    "demo:legacy": "npm run build:legacy && node dist/cli/main.js demo",
    "serve:http:legacy": "node server/http.mjs",
    "prepack": "npm run package:runtime"
  },
  "dependencies": {
    "@tjxjnoobie/strands-bridge": "github:tjXJNOOBIE/strands-bridge#34b2d0129d362edc10b9b540114e81a5cabf082f"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "zod": "4.5.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjXJNOOBIE/Recovery-Agent.git"
  },
  "homepage": "https://github.com/tjXJNOOBIE/Recovery-Agent#readme",
  "bugs": {
    "url": "https://github.com/tjXJNOOBIE/Recovery-Agent/issues"
  },
  "keywords": [
    "strands-agents",
    "agents",
    "mcp",
    "recovery-agent",
    "systemd",
    "self-healing"
  ]
}
