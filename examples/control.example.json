{
  "transport": {
    "mode": "outbound_tls",
    "listenHost": "0.0.0.0",
    "listenPort": 7843,
    "certificateFile": "/etc/recovery/control/control.crt",
    "privateKeyFile": "/etc/recovery/control/control.key",
    "clientCertificateAuthorityFile": "/etc/recovery/control/node-ca.crt",
    "requestTimeoutMs": 10000,
    "enrollmentTimeoutMs": 5000
  },
  "approvalPrincipals": [
    {
      "id": "primary-operator",
      "tokenEnvironmentVariable": "RECOVERY_APPROVAL_TOKEN_PRIMARY",
      "expiresAt": "2027-01-01T00:00:00Z"
    },
    {
      "id": "retired-operator",
      "tokenEnvironmentVariable": "RECOVERY_APPROVAL_TOKEN_RETIRED",
      "revoked": true
    }
  ],
  "durableRetention": {
    "terminalHistoryDays": 90,
    "terminalHistoryPerTarget": 200
  },
  "nodes": [
    {
      "id": "production-east-01",
      "allowedCertificateFingerprints": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "services": [
        {
          "id": "postgres",
          "restartAllowed": true,
          "maxRestartAttempts": 1,
          "restartBudgetWindowSeconds": 600,
          "watchEnabled": true,
          "watchIntervalSeconds": 30
        },
        {
          "id": "payments-api",
          "restartAllowed": true,
          "maxRestartAttempts": 2,
          "restartBudgetWindowSeconds": 600,
          "watchEnabled": true,
          "watchIntervalSeconds": 30,
          "dependencies": [
            { "serviceId": "postgres" }
          ]
        }
      ]
    }
  ]
}
