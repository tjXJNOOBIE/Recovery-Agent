{
  "nodeId": "production-east-01",
  "transport": {
    "mode": "outbound_tls",
    "host": "recovery-control.internal.example",
    "port": 7843,
    "serverName": "recovery-control.internal.example",
    "certificateFile": "/etc/recovery/node/node.crt",
    "privateKeyFile": "/etc/recovery/node/node.key",
    "controlCertificateAuthorityFile": "/etc/recovery/node/control-ca.crt",
    "allowedControlCertificateFingerprints": [
      "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    ],
    "enrollmentTimeoutMs": 5000,
    "reconnectInitialDelayMs": 1000,
    "reconnectMaximumDelayMs": 30000
  },
  "services": [
    {
      "id": "payments-api",
      "unit": "payments-api.service",
      "deploymentMarkerFile": "/opt/payments/deployment.marker",
      "healthChecks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:8080/health",
          "timeoutMs": 2000,
          "expectedStatusCodes": [200]
        }
      ]
    }
  ],
  "certificates": [
    {
      "id": "payments-public-tls",
      "host": "payments.example.com",
      "port": 443,
      "serverName": "payments.example.com",
      "timeoutMs": 3000,
      "warnBeforeDays": 30,
      "criticalBeforeDays": 7
    }
  ]
}
