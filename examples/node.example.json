{
  "nodeId": "production-east-01",
  "listenHost": "127.0.0.1",
  "listenPort": 7281,
  "tokenEnvironmentVariable": "RECOVERY_NODE_TOKEN_EAST_01",
  "services": [
    {
      "id": "payments-api",
      "unit": "payments-api.service",
      "healthChecks": [
        {
          "type": "http",
          "url": "http://127.0.0.1:8080/health",
          "timeoutMs": 2000,
          "expectedStatusCodes": [200]
        }
      ]
    }
  ],
  "certificates": [
    {
      "id": "payments-public-tls",
      "host": "payments.example.com",
      "port": 443,
      "serverName": "payments.example.com",
      "timeoutMs": 3000,
      "warnBeforeDays": 30,
      "criticalBeforeDays": 7
    }
  ]
}
